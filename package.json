{
  "name": "supacatch-js",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "prepare": "effect-tsgo patch && lefthook install",
    "build": "tsc -b packages/*/tsconfig.build.json",
    "typecheck": "bun run build && tsc --noEmit",
    "test": "bun run build && vitest run",
    "lint": "oxlint --fix",
    "lint:check": "oxlint",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "publint": "bun run --filter '*' publint",
    "check:versions": "bun scripts/check-package-versions.ts",
    "check": "bun run lint:check && bun run format:check && bun run check:versions && bun run build && tsc --noEmit && vitest run && bun run publint"
  },
  "devDependencies": {
    "@effect/tsgo": "0.45.0",
    "@effect/vitest": "4.0.0-beta.103",
    "@supainc/supacatch-browser": "workspace:*",
    "@supainc/supacatch-bun": "workspace:*",
    "@supainc/supacatch-cloudflare": "workspace:*",
    "@supainc/supacatch-core": "workspace:*",
    "@supainc/supacatch-effect": "workspace:*",
    "@supainc/supacatch-node": "workspace:*",
    "@supainc/supacatch-tanstack-start": "workspace:*",
    "@types/node": "26.6.2",
    "effect": "4.0.0-beta.103",
    "lefthook": "2.1.14",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "publint": "0.3.24",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "bun@1.3.14"
}
