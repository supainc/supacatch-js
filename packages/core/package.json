{
  "name": "@supainc/supacatch",
  "version": "0.1.0-alpha.5",
  "description": "Core SupaCatch JavaScript SDK",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/supainc/supacatch-js.git",
    "directory": "packages/core"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./effect": {
      "types": "./dist/effect.d.ts",
      "import": "./dist/effect.js"
    },
    "./internal/automatic": {
      "types": "./dist/internal/automatic.d.ts",
      "import": "./dist/internal/automatic.js"
    },
    "./internal/context": {
      "types": "./dist/internal/context.d.ts",
      "import": "./dist/internal/context.js"
    },
    "./internal/dedupe": {
      "types": "./dist/internal/dedupe.d.ts",
      "import": "./dist/internal/dedupe.js"
    },
    "./internal/fatal": {
      "types": "./dist/internal/fatal.d.ts",
      "import": "./dist/internal/fatal.js"
    },
    "./internal/runtime": {
      "types": "./dist/internal/runtime.d.ts",
      "import": "./dist/internal/runtime.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "bun ../../scripts/clean.ts dist && tsc -p tsconfig.build.json",
    "publint": "publint"
  },
  "peerDependencies": {
    "effect": "4.0.0-beta.103"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
