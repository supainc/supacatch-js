{
  "name": "@supainc/supacatch-bun",
  "version": "0.1.0-alpha.5",
  "description": "SupaCatch SDK for Bun",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/supainc/supacatch-js.git",
    "directory": "packages/bun"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "bun ../../scripts/clean.ts dist && tsc -p tsconfig.build.json && bun ../../scripts/add-ts-self-types.ts dist",
    "publint": "publint"
  },
  "dependencies": {
    "@supainc/supacatch-node": "0.1.0-alpha.5"
  },
  "peerDependencies": {
    "effect": "4.0.0-beta.103"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
